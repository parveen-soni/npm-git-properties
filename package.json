{
  "name": "npm-git-properties",
  "version": "2.0.0",
  "author": "parveen-rx",
  "description": "Generate repository git details",
  "bugs": {
    "url": "https://github.com/parveen-rx/npm-git-properties/issues"
  },
  "homepage": "https://github.com/parveen-rx/npm-git-properties",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "git-properties": "dist/cli.js",
    "npm-git-properties": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.mjs",
      "require": "./dist/constants.js"
    }
  },
  "keywords": [
    "git",
    "git-properties",
    "actuator",
    "spring-boot",
    "express-actuator",
    "git-info",
    "git-revision",
    "commit-hash",
    "build-info",
    "ci-cd",
    "docker",
    "zero-dependency"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "examples": "node examples/example-simple.js",
    "examples-detailed": "node examples/example-complex.js",
    "test": "jest",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:parveen-rx/npm-git-properties.git"
  },
  "dependencies": {},
  "contributors": [
    {
      "name": "Parveen Soni",
      "email": "thelastestcomputing@gmail.com",
      "url": "https://about.me/parveen.soni"
    }
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
